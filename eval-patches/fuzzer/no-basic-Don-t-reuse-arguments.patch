             known_args: Vec::<Argument>::new(),
-            reuse_chance: 50,
-            power_of_two_chance: 50,
+            reuse_chance: 0,
+            power_of_two_chance: 0,
         }
     }
 
@@ -29,23 +29,23 @@ impl InstGenerator {
