 src/mutator.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index f9105d5..af89530 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -276,7 +276,7 @@ pub type RiscVMutationList = tuple_list_type!(
     RiscVInstructionMutator,
     RiscVInstructionMutator,
     RiscVInstructionMutator,
-    RiscVInstructionMutator,
+    // RiscVInstructionMutator,
 );
 
 /// Provides a list of all supported RISC-V instruction mutators.
@@ -294,7 +294,7 @@ pub fn all_riscv_mutations() -> RiscVMutationList {
         RiscVInstructionMutator::new(Mutation::RepeatSeveral),
         RiscVInstructionMutator::new(Mutation::SwapTwo),
         RiscVInstructionMutator::new(Mutation::SwapTwo),
-        RiscVInstructionMutator::new(Mutation::Snippet),
+        // RiscVInstructionMutator::new(Mutation::Snippet),
     )
 }
 
